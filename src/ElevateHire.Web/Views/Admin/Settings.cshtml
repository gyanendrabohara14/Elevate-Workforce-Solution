@{
    ViewData["Title"] = "Admin Settings";
    var aiEnabled = (bool)(ViewBag.AIEnabled ?? false);
    var aiStatusText = aiEnabled ? "Enabled" : "Not configured";
    var aiStatusTone = aiEnabled ? "success" : "warning";
}

<partial name="_AdminNav" />

<div class="page-header">
    <div class="container">
        <h1>Settings</h1>
        <p>Platform configuration overview.</p>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="panel">
                <h4 class="panel__title">AI Features</h4>
                <div class="d-flex justify-content-between align-items-center">
                    <span>AI resume matching & insights</span>
                    <partial name="_StatusBadge" model="(aiStatusText, aiStatusTone)" />
                </div>
                <p class="text-muted mt-3 mb-0">Set a Gemini API key in <code>appsettings.json</code> to enable AI candidate insights and cover letter generation.</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel">
                <h4 class="panel__title">About</h4>
                <p class="mb-1"><strong>ElevateWorkforce</strong> is an AI-assisted job recruitment platform for Nepal.</p>
                <p class="text-muted mb-0">Stack: ASP.NET Core MVC · PostgreSQL · EF Core · Identity · Gemini API. This page is informational; configuration lives in <code>appsettings.json</code>.</p>
            </div>
        </div>
    </div>
</div>