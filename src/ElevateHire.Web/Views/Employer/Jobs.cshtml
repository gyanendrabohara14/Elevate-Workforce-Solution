@model JobListViewModel
@{
    ViewData["Title"] = "Manage Jobs";
    ViewData["NavActive"] = "jobs";
    ViewData["SidebarTitle"] = Model.Company.Name;
    ViewData["SidebarSub"] = Model.Company.Industry;
}

<div class="dash-shell">
    <partial name="_EmployerNav" />
    <main class="dash-main">
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <p class="eyebrow mb-1">@Model.Company.Name</p>
                    <h1>Manage jobs</h1>
                    <p class="mb-0">@Model.Total job@(Model.Total == 1 ? "" : "s") published by your company.</p>
                </div>
                <a asp-controller="Employer" asp-action="CreateJob" class="btn btn-primary">Post a job</a>
            </div>

            @if (!Model.Jobs.Any())
            {
                <div class="empty-state">
                    <div class="empty-state__icon">💼</div>
                    <h4>No jobs posted yet</h4>
                    <p>Create your first job posting to start receiving applications.</p>
                    <a asp-controller="Employer" asp-action="CreateJob" class="btn btn-primary mt-2">Post a job</a>
                </div>
            }
            else
            {
                <div class="panel">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Job title</th>
                                    <th>Applications</th>
                                    <th>Status</th>
                                    <th>Posted</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model.Jobs)
                                {
                                    <tr>
                                        <td><a asp-controller="Employer" asp-action="Applicants" asp-route-jobId="@job.Id"><strong>@job.Title</strong></a></td>
                                        <td>@job.Applications.Count</td>
                                        <td><partial name="_StatusBadge" model="(job.StatusDisplay, JobTone(job))" /></td>
                                        <td>@(job.PublishedAt?.ToString("MMM d, yyyy") ?? "—")</td>
                                        <td class="text-end">
                                            <a asp-controller="Employer" asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-sm btn-ghost">Edit</a>
                                            <form asp-controller="Employer" asp-action="DeleteJob" asp-route-id="@job.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this job?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-ghost">Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4" aria-label="Job pages">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-controller="Employer" asp-action="Jobs" asp-route-page="@(Model.Page - 1)">Previous</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-controller="Employer" asp-action="Jobs" asp-route-page="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-controller="Employer" asp-action="Jobs" asp-route-page="@(Model.Page + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </main>
</div>

@functions {
    string JobTone(ElevateWorkforce.Domain.Entities.Job job)
    {
        if (job.Status == ElevateWorkforce.Domain.Enums.JobStatus.Active && !job.IsExpired) return "success";
        if (job.Status == ElevateWorkforce.Domain.Enums.JobStatus.PendingVerification) return "warning";
        return job.Status == ElevateWorkforce.Domain.Enums.JobStatus.Rejected ? "danger" : "neutral";
    }
}