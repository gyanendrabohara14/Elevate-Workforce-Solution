@model CompanyFormViewModel
@{
    ViewData["Title"] = "Company Profile";
    var status = ViewBag.CompanyStatus as ElevateWorkforce.Domain.Enums.CompanyStatus? ?? ElevateWorkforce.Domain.Enums.CompanyStatus.PendingVerification;
    string Tone(ElevateWorkforce.Domain.Enums.CompanyStatus s) => s switch
    {
        ElevateWorkforce.Domain.Enums.CompanyStatus.Active => "success",
        ElevateWorkforce.Domain.Enums.CompanyStatus.PendingVerification => "warning",
        ElevateWorkforce.Domain.Enums.CompanyStatus.Rejected => "danger",
        _ => "neutral"
    };
}

<div class="dash-shell">
    <aside class="dash-sidebar">
        <h4 class="dash-sidebar__title">Employer</h4>
        <a asp-controller="Employer" asp-action="Dashboard">Dashboard</a>
        <a asp-controller="Employer" asp-action="Company" class="active">Company Profile</a>
        <a asp-controller="Employer" asp-action="Jobs">Manage Jobs</a>
        <a asp-controller="Employer" asp-action="CreateJob">Post a Job</a>
        <a asp-controller="Employer" asp-action="Applicants">Applicants</a>
    </aside>
    <main class="dash-main">
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <p class="eyebrow mb-1">Company</p>
                    <h1>Company profile</h1>
                </div>
                <span class="badge-soft badge-soft--@Tone(status)">@status</span>
            </div>
        </div>

        @if (status == ElevateWorkforce.Domain.Enums.CompanyStatus.PendingVerification)
        {
            <div class="alert-banner alert-banner--warning">
                <div class="alert-banner__icon">⏳</div>
                <div>
                    <div class="alert-banner__title">Awaiting administrator verification</div>
                    <p>Once approved, jobs you post will go live instantly. Saved changes below don't affect the review in progress.</p>
                </div>
            </div>
        }
        else if (status == ElevateWorkforce.Domain.Enums.CompanyStatus.Rejected)
        {
            <div class="alert-banner alert-banner--danger">
                <div class="alert-banner__icon">✕</div>
                <div>
                    <div class="alert-banner__title">Company profile not approved</div>
                    <p>Review your details, fix anything that's missing, then save. It will be sent back for verification.</p>
                </div>
            </div>
        }
        else
        {
            <div class="alert-banner alert-banner--success">
                <div class="alert-banner__icon">✓</div>
                <div>
                    <div class="alert-banner__title">Verified company</div>
                    <p>Your profile is verified. Jobs you post go live immediately.</p>
                </div>
            </div>
        }

        @if (ViewBag.FirstTime == true)
        {
            <div class="info-box mb-4">Before posting jobs, tell us about your company. An administrator will verify it.</div>
        }

            <form asp-controller="Employer" asp-action="Company" method="post" enctype="multipart/form-data" class="panel">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Company name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Industry" class="form-label">Industry</label>
                        <input asp-for="Industry" class="form-control" placeholder="e.g. IT Services, Banking, E-commerce" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="What does your company do?"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Website" class="form-label">Website</label>
                        <input asp-for="Website" class="form-control" placeholder="https://" />
                        <span asp-validation-for="Website" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Location" class="form-label">Head office location</label>
                        <input asp-for="Location" class="form-control" placeholder="Kathmandu" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ContactEmail" class="form-label">Contact email</label>
                        <input asp-for="ContactEmail" class="form-control" />
                        <span asp-validation-for="ContactEmail" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactPhone" class="form-label">Contact phone</label>
                        <input asp-for="ContactPhone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Logo" class="form-label">Logo (PNG, JPG, SVG, WEBP · max 2 MB)</label>
                        <input asp-for="Logo" type="file" class="form-control" accept=".png,.jpg,.jpeg,.svg,.webp" />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Save company profile</button>
                    <a asp-controller="Employer" asp-action="Dashboard" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}