@model ApplicationsDashboardListViewModel
@{
    ViewData["Title"] = "My Applications";
    ViewData["NavActive"] = "applications";
}

<div class="dash-shell">
    <partial name="_JobSeekerNav" />
    <main class="dash-main">
        <div class="container py-4">
            <div class="mb-4">
                <p class="eyebrow mb-1">Tracking</p>
                <h1>My applications</h1>
                <p class="mb-0">Follow the status of every application you've submitted.</p>
            </div>

            @if (!Model.Applications.Any())
            {
                <div class="empty-state">
                    <div class="empty-state__icon">📄</div>
                    <h4>No applications yet</h4>
                    <p>Browse open roles and submit your first application.</p>
                    <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary mt-2">Find jobs</a>
                </div>
            }
            else
            {
                <div class="panel">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Position</th>
                                    <th>Company</th>
                                    <th>Status</th>
                                    <th>Applied</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.Applications)
                                {
                                    <tr>
                                        <td><a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobId"><strong>@app.Job?.Title</strong></a></td>
                                        <td>@app.Job?.Company?.Name</td>
                                        <td><partial name="_StatusBadge" model="(app.Status.ToString(), AppTone(app.Status))" /></td>
                                        <td>@app.CreatedAt.ToString("MMM d, yyyy")</td>
                                        <td class="text-end">
                                            <a asp-controller="Applications" asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-ghost">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4" aria-label="Applications pages">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-controller="JobSeeker" asp-action="Applications" asp-route-page="@(Model.Page - 1)">Previous</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-controller="JobSeeker" asp-action="Applications" asp-route-page="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-controller="JobSeeker" asp-action="Applications" asp-route-page="@(Model.Page + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </main>
</div>

@functions {
    string AppTone(ElevateWorkforce.Domain.Enums.ApplicationStatus status) => status switch
    {
        ElevateWorkforce.Domain.Enums.ApplicationStatus.Selected => "success",
        ElevateWorkforce.Domain.Enums.ApplicationStatus.Interview or ElevateWorkforce.Domain.Enums.ApplicationStatus.Shortlisted => "info",
        ElevateWorkforce.Domain.Enums.ApplicationStatus.Rejected or ElevateWorkforce.Domain.Enums.ApplicationStatus.Withdrawn => "danger",
        _ => "warning"
    };
}