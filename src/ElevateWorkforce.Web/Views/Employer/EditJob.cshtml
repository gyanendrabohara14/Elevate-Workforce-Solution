@model JobFormViewModel
@{
    ViewData["Title"] = "Edit Job";
    ViewData["NavActive"] = "jobs";
    ViewData["FormAction"] = "EditJob";
    ViewData["SubmitText"] = "Save changes";
}

<div class="dash-shell">
    <partial name="_EmployerNav" />
    <main class="dash-main">
        <div class="container py-4">
            <div class="mb-4">
                <p class="eyebrow mb-1">@Model.Title</p>
                <h1>Edit job</h1>
                <p class="mb-0">Edits to a rejected job will resubmit it for verification.</p>
            </div>
            <partial name="_JobForm" model="@Model" />
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}