@model HomeViewModel
@{
    ViewData["Title"] = "Find work that moves you forward.";
    ViewData["BodyClass"] = "page-home";
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h1 class="hero__heading hero-reveal">Find work that<br />moves you <em>forward.</em></h1>
                <p class="hero__sub hero-reveal">
                    Elevate Workforce Solutions connects job seekers with trusted employers
                    across Nepal. Discover roles, apply with confidence, and find the right
                    next step for your career.
                </p>
                <form asp-controller="Jobs" asp-action="Index" method="get" class="hero__search hero-reveal">
                    <div class="hero__search-field">
                        <label for="keyword">Keyword</label>
                        <input id="keyword" name="keyword" class="form-control" placeholder="Job title or skill" aria-label="Search jobs" />
                    </div>
                    <div class="hero__search-field">
                        <label for="location">Location</label>
                        <input id="location" name="location" class="form-control" placeholder="City" aria-label="Location" />
                    </div>
                    <button type="submit" class="btn btn-primary">Search</button>
                </form>
            </div>
            <div class="col-lg-6">
                <div class="hero__visual" role="img" aria-label="A preview of job opportunities and candidate matches">
                    <div class="hero-board">
                        <div class="hero-board__top">
                            <span class="hero-board__label"><span class="hero-board__live"></span> Your next step</span>
                            <span class="hero-board__count">3 new matches</span>
                        </div>
                        <div class="hero-board__intro">
                            <span class="hero-board__eyebrow">Recommended for you</span>
                            <h2>Good work is closer than you think.</h2>
                            <p>Opportunities matched to your skills and goals.</p>
                        </div>
                        <article class="hero-board__job">
                            <div class="hero-board__company">K</div>
                            <div class="hero-board__details">
                                <span class="hero-board__company-name">Kantipur Digital</span>
                                <h3>Product Designer</h3>
                                <span class="hero-board__meta">Kathmandu · Full time</span>
                            </div>
                            <span class="hero-board__match">92% match</span>
                        </article>
                        <article class="hero-board__job hero-board__job--muted">
                            <div class="hero-board__company hero-board__company--alt">W</div>
                            <div class="hero-board__details">
                                <span class="hero-board__company-name">WorldLink</span>
                                <h3>UX Researcher</h3>
                                <span class="hero-board__meta">Lalitpur · Hybrid</span>
                            </div>
                            <span class="hero-board__arrow" aria-hidden="true">↗</span>
                        </article>
                        <div class="hero-board__footer"><span>Thoughtful matches. Real opportunities.</span><span aria-hidden="true">✳</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
            <div>
                <span class="eyebrow">Featured opportunities</span>
                <h2 class="section__title">Fresh roles from Nepal's top teams</h2>
            </div>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-ghost">View all jobs →</a>
        </div>
        <div class="row g-4">
            @foreach (var job in Model.FeaturedJobs)
            {
                <div class="col-md-6 col-lg-4 reveal">
                    <partial name="~/Views/Jobs/_JobCard.cshtml" model="(job, false)" />
                </div>
            }
        </div>
    </div>
</section>

<section class="section how-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow">How it works</span>
            <h2 class="section__title">Recruitment, made transparent</h2>
        </div>
        <div class="how-grid">
            <div class="how-step how-step--left reveal">
                <div class="how-step__num">01</div>
                <h3>Employers post jobs</h3>
                <p>Verify your company once, then publish detailed listings that go live for every candidate.</p>
            </div>
            <div class="how-step how-step--right reveal">
                <div class="how-step__num">02</div>
                <h3>Seekers apply</h3>
                <p>Candidates build a structured profile, upload a resume and apply to matching roles in a few clicks.</p>
            </div>
            <div class="how-step how-step--left reveal">
                <div class="how-step__num">03</div>
                <h3>AI assists the match</h3>
                <p>Our AI highlights matching skills and gaps so both sides move forward with clearer insight.</p>
            </div>
        </div>
    </div>
</section>

<section class="split-band">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6 reveal">
                <h2>Take control of your career</h2>
                <ul class="split-list">
                    <li>Search with intent filter by role, location, salary and experience.</li>
                    <li>Track every application from applied to interview.</li>
                    <li>Build a profile once and apply everywhere.</li>
                </ul>
                <a asp-controller="Account" asp-action="Register" asp-route-role="JobSeeker" class="btn btn-primary mt-2">Create my profile</a>
            </div>
            <div class="col-lg-6 reveal">
                <h2>Hire with confidence</h2>
                <ul class="split-list">
                    <li>Verified companies post jobs that go live instantly.</li>
                    <li>Manage a clear candidate pipeline: shortlist, interview, hire.</li>
                    <li>Use AI-assisted insights to focus interviews where they matter.</li>
                </ul>
                <a asp-controller="Account" asp-action="Register" asp-route-role="Employer" class="btn btn-primary mt-2">Post your first job</a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="eyebrow">Trusted by people like you</span>
            <h2 class="section__title">Careers that found their direction</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 reveal">
                <div class="testimonial">
                    <p class="testimonial__quote">"I applied to three roles in a week and could see exactly where each stood. No more wondering whether anyone had even seen my application."</p>
                    <div class="testimonial__author">
                        <div class="testimonial__avatar">AG</div>
                        <div>
                            <div class="testimonial__name">Anita Gurung</div>
                            <div class="testimonial__meta">Data Analyst · Kathmandu</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 reveal">
                <div class="testimonial">
                    <p class="testimonial__quote">"The AI-assisted insights helped our team focus interviews on the candidates who truly fit, saving us hours of screening."</p>
                    <div class="testimonial__author">
                        <div class="testimonial__avatar">PA</div>
                        <div>
                            <div class="testimonial__name">Priya Adhikari</div>
                            <div class="testimonial__meta">HR Manager · Kathmandu</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 reveal">
                <div class="testimonial">
                    <p class="testimonial__quote">"Applying was straightforward and I always knew the current status of my application. The timeline feature is genuinely useful."</p>
                    <div class="testimonial__author">
                        <div class="testimonial__avatar">SK</div>
                        <div>
                            <div class="testimonial__name">Suman Karki</div>
                            <div class="testimonial__meta">Frontend Developer · Kathmandu</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt cta-band">
    <div class="container text-center">
        <h2 class="section__title">Ready to move your career forward?</h2>
        <a asp-controller="Account" asp-action="GetStarted" class="btn btn-primary btn-lg mt-2">Get Started</a>
    </div>
</section>

<section class="section faq-section">
    <div class="container">
        <h2 class="section__title mb-4">Frequently asked questions</h2>
        <div class="faq-list accordion" id="faqAccordion">
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">How do I create an account and start applying?</button>
                </h3>
                <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Choose Get Started, select Job Seeker, and complete your profile. You can then browse roles and apply in a few clicks.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">How do employers post jobs on the platform?</button>
                </h3>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Create an employer account, complete your company profile for verification, then post jobs from the employer portal.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">How does AI assistance work in matching?</button>
                </h3>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">AI highlights overlapping skills and gaps so people can decide faster. It never replaces a hiring manager's judgement.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">Can I manage applications as a seeker?</button>
                </h3>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Yes. Your dashboard tracks every application from under review to interview and offer.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">Can employers manage candidates through filters?</button>
                </h3>
                <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Employers can filter applicants by job and status, then shortlist, interview, or reject from one pipeline.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">Is there support for multiple locations or job types?</button>
                </h3>
                <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">Yes. Search by city, category, job type, experience and salary, including remote and hybrid roles.</div>
                </div>
            </div>
        </div>
    </div>
</section>
